{
  "$schema": "./web/node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["web/**/*.ts", "web/**/*.css", "web/**/*.json", "!**/node_modules", "!**/dist"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": { "noImportantStyles": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
